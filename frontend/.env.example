# ── Google Maps ──────────────────────────────────────────────────────────────
# Paste your Google Maps API key here (get one at https://console.cloud.google.com)
# Required APIs to enable on the key:
#   Maps JavaScript API
#   Places API (for autocomplete)
#   Geocoding API
VITE_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── Backend URL ───────────────────────────────────────────────────────────────
# VITE_API_URL=http://127.0.0.1:8000

# ── Geocoder bounds (Kolkata default) ────────────────────────────────────────
# VITE_SEARCH_VIEWBOX=88.15,22.75,88.55,22.40
# VITE_SEARCH_COUNTRY=in
